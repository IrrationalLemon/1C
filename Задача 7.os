&НаКлиенте
Процедура КлиентНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаОбработка = Ложь;
	
	СписокКлиентов = ВыводКлиентов();
	
	Если СписокКлиентов = Неопределено ИЛИ СписокКлиентов.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список клиентов вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыборкаКлиент", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, СписокКлиентов, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыборкаКлиент(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Клиент = ДополнительныеПараметры.ТекущиеДанные;
	Объект.Клиент = ВыбранныйЭлемент.Значение;
	
КонецПроцедуры

&НаСервере()
Функция ВыводКлиентов()
	
	СписокКлиентов = Новый СписокЗначений;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ЭтоКлиент = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокКлиентов.Добавить(Выборка.Ссылка, Выборка.Наименование);
		
	КонецЦикла;
	
	Возврат СписокКлиентов;
	
КонецФункции

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	Товары = ПолучитьТоварыИзЗаказа(Объект.Заказ);
	СтрочкаТЧ = Элементы.СписокТоваров.ТекущиеДанные; 
	
	Если Товары.Количество() = 0 ИЛИ Товары = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список товаров вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	Для Каждого СтрочкаТЧ Из Товары Цикл
		СтрочкаТЧ.Товар = Товары.Товар;
		СтрочкаТЧ.Количество = Товары.Количество;
	КонецЦикла;
КонецПроцедуры




&НаСервере
Функция ПолучитьКонтакты(Клиент)
	
	СписокКонтактов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.КонтактныеЛица.(
		|		Ссылка КАК Ссылка,
		|		КонтактныеЛица КАК КонтактныеЛица
		|	) КАК КонтактныеЛица
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.КонтактныеЛица.Ссылка = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокКонтактов.Добавить(Выборка.КонтактныеЛица);
		
	КонецЦикла;
	
	Возврат СписокКонтактов;
	
КонецФункции


&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	Товары = ПолучитьТоварыИзЗаказа(Объект.Заказ);
	
	Если Товары.Количество() = 0 ИЛИ Товары = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список товаров вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Объект.СписокТоваров.Очистить();
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Объект.СписокТоваров.Добавить();
		НоваяСтрока.Товар = Стр.Товар;
		НоваяСтрока.Количество = Стр.Количество;
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварыИзЗаказа(Заказ)
	
	СписокТоваров = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаСписокТоваров.Товар КАК Товар,
		|	ЗаказКлиентаСписокТоваров.Количество КАК Количество
		|ИЗ
		|	Документ.ЗаказКлиента.СписокТоваров КАК ЗаказКлиентаСписокТоваров
		|ГДЕ
		|	ЗаказКлиентаСписокТоваров.Ссылка = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокТоваров.Добавить(Выборка.Товар, Выборка.Количество);
		
	КонецЦикла;
	
	Возврат СписокТоваров;
КонецФункции


Поле объекта не обнаружено (Товар)
{Документ.ЗаказПоставщику.Форма.ФормаДокумента.Форма(18)}:НоваяСтрока.Товар = Стр.Товар;
