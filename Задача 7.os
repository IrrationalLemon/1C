&НаКлиенте
Процедура КомандаФормирования(Команда)
	
	Заказы = ВывестиЗаказыКлиентов();
	
	Объект.СписокЗаказов.Очистить();
	
	Для Каждого стр Из Заказы Цикл
		
		НоваяСтрока = Объект.СписокЗаказов.Добавить();		
		НоваяСтрока.Клиент = стр.Клиент;
		НоваяСтрока.Заказ = стр.Заказ;
		НоваяСтрока.Товар = стр.Товар;
		НоваяСтрока.ЦенаПоставщика = ЦенаПоставщикаПодставить(стр.Товар, Объект.Поставщик);
		НоваяСтрока.Количество = стр.Количество;
		НоваяСтрока.Сумма = стр.Количество * НоваяСтрока.ЦенаПоставщика;
		
	КонецЦикла
	
КонецПроцедуры

&НаСервере
Функция ВывестиЗаказыКлиентов()

	МассивЗаказов = Новый Массив;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиЗаказовОстатки.Клиент КАК Клиент,
		|	ОстаткиЗаказовОстатки.Заказ КАК Заказ,
		|	ОстаткиЗаказовОстатки.Товар КАК Товар,
		|	ОстаткиЗаказовОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиЗаказов.Остатки(, ) КАК ОстаткиЗаказовОстатки";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МассивЗаказов.Добавить(Новый Структура("Клиент, Заказ, Товар, Количество", Выборка.Клиент, Выборка.Заказ, Выборка.Товар, Выборка.Количество));
		
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

&НаСервере
Функция ЦенаПоставщикаПодставить(Товар, Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныПоставщикаСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныПоставщика.СрезПоследних(
		|			&Дата,
		|			Товар = &Товар
		|				И Поставщик = &Поставщик) КАК ЦеныПоставщикаСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе	
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Возврат Выборка.Цена;
			
		КонецЦикла;
		
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура СписокЗаказовКоличествоПриИзменении(Элемент)
	
	ПересчетСуммы(Элементы.СписокЗаказов.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовЦенаПоставщикаПриИзменении(Элемент)
	
	 ПересчетСуммы(Элементы.СписокЗаказов.ТекущиеДанные);
	
КонецПроцедуры


&НаКлиенте
Процедура ПересчетСуммы(СтрочкаТЧ)

	СтрочкаТЧ.Сумма = СтрочкаТЧ.Количество * СтрочкаТЧ.ЦенаПоставщика; 	
	
КонецПроцедуры


&НаКлиенте
Процедура КонтактноеЛицоПриИзменении(Элемент)
	
	Если Объект.Поставщик.Пустая() Тогда
		
		Объект.КонтактноеЛицо.Пустая();
		
	КонецЕсли;
	
КонецПроцедуры

// модуль объекта

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.Записать();
	Движения.ОстаткиЗаказов.Записывать = Истина;
	
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщикуСписокЗаказов.Клиент КАК Клиент,
		|	ЗаказПоставщикуСписокЗаказов.Заказ КАК Заказ,
		|	ЗаказПоставщикуСписокЗаказов.Товар КАК Товар,
		|	СУММА(ЗаказПоставщикуСписокЗаказов.Количество) КАК Количество
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Документ.ЗаказПоставщику.СписокЗаказов КАК ЗаказПоставщикуСписокЗаказов
		|ГДЕ
		|	ЗаказПоставщикуСписокЗаказов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПоставщикуСписокЗаказов.Клиент,
		|	ЗаказПоставщикуСписокЗаказов.Заказ,
		|	ЗаказПоставщикуСписокЗаказов.Товар
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ,
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Клиент КАК Клиент,
		|	вт.Заказ КАК Заказ,
		|	вт.Товар КАК Товар,
		|	вт.Количество КАК Количество,
		|	ЕСТЬNULL(ОстаткиЗаказовОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЗаказов.Остатки(
		|				&МоментВремени,
		|				(Заказ, Товар) В
		|					(ВЫБРАТЬ
		|						вт.Заказ КАК Заказ,
		|						вт.Товар КАК Товар
		|					ИЗ
		|						вт КАК вт)) КАК ОстаткиЗаказовОстатки
		|		ПО вт.Заказ = ОстаткиЗаказовОстатки.Заказ
		|			И вт.Товар = ОстаткиЗаказовОстатки.Товар";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество > Выборка.КоличествоОстаток ИЛИ Выборка.Количество < 0 Тогда
			
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "пупупу";
			Сообщение.Сообщить();
			
		КонецЕсли;
		
		Если Отказ Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Движение = Движения.ОстаткиЗаказов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Клиент = Выборка.Клиент;
		Движение.Заказ = Выборка.Заказ;
		Движение.Товар = Выборка.Товар;
		Движение.Количество = Выборка.Количество;
		
	КонецЦикла;
	
КонецПроцедуры
