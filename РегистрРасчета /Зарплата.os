// рассчитываем зарплату в модуле менеджера Зарплата (регистр расчета)
Процедура Рассчитать(Регистратор) Экспорт

	Данные = СоздатьНаборЗаписей();
	Данные.Отбор.Регистратор.Значение = Регистратор;
	
	Данные.Прочитать();
	
	Для каждого Запись Из Данные Цикл
		
		Если Запись.ВидРасчета = ПланыВидовРасчета.НачисленияИУдержания.Оклад Тогда
			
			ОтработаноЧасов = Запись.ПолучитьДанныеГрафика(ВидПериодаРегистраРасчета.ФактическийПериодДействия).Итог("Часы");
			ЧасовПоНорме	= Запись.ПолучитьДанныеГрафика(ВидПериодаРегистраРасчета.ПериодДействия).Итог("Часы");
			СуммаОклада 	= Запись.ПараметрРасчета;
			
			Значение = СуммаОклада/ЧасовПоНорме * ОтработаноЧасов;
			
			Запись.Сумма = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Данные.Записать();
	
КонецПроцедуры
