// проводим движение в документе РасчетнаяВедомость
Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.Зарплата.Записывать = Истина;
	Движение = Движения.Зарплата.Добавить();
	Движение.Сторно = Ложь;
	Движение.ВидРасчета = ПланыВидовРасчета.НачисленияИУдержания.Прогул;
	Движение.ПериодДействияНачало = НачалоДня(Дата);
	Движение.ПериодДействияКонец = КонецДня(Дата);
	Движение.ПериодРегистрации = Дата;
	Движение.Сотрудник = Сотрудник;

КонецПроцедуры





