// вот так можно рассчитать премию. Единственное что я пока не сильно понимаю как тут работает второй цикл
// но это в разы лучше, чем писать какой-то длинный запрос

Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр РасчетПремий
	Движения.РасчетПремий.Записывать = Истина;
	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.РасчетПремий.Добавить();
		Движение.Сторно = Ложь;
		Движение.ВидРасчета = ТекСтрокаСостав.ВидПремии;
		Движение.ПериодРегистрации = ЗаМесяц;
		Движение.БазовыйПериодНачало = НачалоМесяца(ЗаМесяц);
		Движение.БазовыйПериодКонец = КонецМесяца(ЗаМесяц);
		Движение.Сотрудник = ТекСтрокаСостав.Сотрудник;
		Движение.ПараметрРасчета = ТекСтрокаСостав.Процент;
	КонецЦикла;
	
	Движения.РасчетПремий.Записать();
	
	Для каждого Запись Из Движения.РасчетПремий Цикл
		
		Ресурсы = Новый Массив;
		Ресурсы.Добавить("Зарплата.Сумма");
		
		Измерения = Новый Структура;
		Измерения.Вставить("Сотрудник", "Зарплата.Сотрудник");
		
		СуммаБазы = Запись.ПолучитьБазу(Ресурсы, Измерения).Итог("Сумма");
		Запись.Сумма = СуммаБазы/100*Запись.ПараметрРасчета
		
	КонецЦикла;
	
КонецПроцедуры
