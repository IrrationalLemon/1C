Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.Записать();
	Движения.ОстаткиТовара.Записывать = Истина;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродажаТовараСписокТовара.Товар КАК Товар,
		|	ПродажаТовараСписокТовара.Партия КАК Партия,
		|	СУММА(ПродажаТовараСписокТовара.Количество) КАК Количество
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Документ.ПродажаТовара.СписокТовара КАК ПродажаТовараСписокТовара
		|ГДЕ
		|	ПродажаТовараСписокТовара.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажаТовараСписокТовара.Товар,
		|	ПродажаТовараСписокТовара.Партия
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Товар КАК Товар,
		|	вт.Партия КАК Партия,
		|	вт.Количество КАК Количество,
		|	ЕСТЬNULL(ОстаткиТовараОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	вт.Товар.Представление КАК ТоварПредставление,
		|	ОстаткиТовараОстатки.СрокГодности КАК СрокГодности
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
		|				&МоментВремени,
		|				Товар В
		|					(ВЫБРАТЬ
		|						вт.Товар КАК вт
		|					ИЗ
		|						вт)) КАК ОстаткиТовараОстатки
		|		ПО вт.Товар = ОстаткиТовараОстатки.Товар
		|ИТОГИ
		|	МАКСИМУМ(Количество),
		|	СУММА(КоличествоОстаток)
		|ПО
		|	Товар,
		|	Партия";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТовар = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТовар.Следующий() Цикл
		
		Если ВыборкаТовар.Количество > ВыборкаТовар.КоличествоОстаток Тогда
		
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает товара: " + ВыборкаТовар.ТоварПредставление + " в количестве " + ВыборкаТовар.КоличествоОстаток;;
			Сообщение.Сообщить();
		
		КонецЕсли;
		
		КоличествоСписать = ВыборкаТовар.Количество;
			
		ВыборкаПартия = ВыборкаТовар.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаПартия.Следующий() И КоличествоСписать > 0 Цикл
			Движение = Движения.ОстаткиТовара.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = ВыборкаПартия.Товар;
			Движение.Количество = МИН(КоличествоСписать, ВыборкаПартия.КоличествоОстаток);
			Движение.СрокГодности = ВыборкаПартия.СрокГодности;
			
			КоличествоСписать = КоличествоСписать - Движение.Количество;
		КонецЦикла;
	КонецЦикла;
	
	
КонецПроцедуры
