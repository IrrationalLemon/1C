Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.Записать();
	Движения.ОстаткиТовара.Записывать = Истина;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродажаТовараСписокТовара.Товар КАК Товар,
		|	ПродажаТовараСписокТовара.Партия КАК Партия,
		|	СУММА(ПродажаТовараСписокТовара.Количество) КАК Количество
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Документ.ПродажаТовара.СписокТовара КАК ПродажаТовараСписокТовара
		|ГДЕ
		|	ПродажаТовараСписокТовара.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажаТовараСписокТовара.Товар,
		|	ПродажаТовараСписокТовара.Партия
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар,
		|	Партия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Товар КАК Товар,
		|	вт.Партия КАК Партия,
		|	вт.Количество КАК Количество,
		|	ЕСТЬNULL(ОстаткиТовараОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	вт.Товар.Представление КАК ТоварПредставление,
		|	вт.Партия.Представление КАК ПартияПредставление,
		|	&Период КАК Период,
		|	ОстаткиТовараОстатки.СрокГодности КАК СрокГодности
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
		|				&МоментВремени,
		|				(Товар, Партия) В
		|					(ВЫБРАТЬ
		|						вт.Товар КАК Товар,
		|						вт.Партия КАК Партия
		|					ИЗ
		|						вт КАК вт)) КАК ОстаткиТовараОстатки
		|		ПО вт.Товар = ОстаткиТовараОстатки.Товар
		|			И вт.Партия = ОстаткиТовараОстатки.Партия";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество > Выборка.КоличествоОстаток Тогда
		
			 Отказ = Истина;
			 
			 Сообщение = Новый СообщениеПользователю;
			 Сообщение.Текст = "пупупу";
			 Сообщение.Сообщить();
		
		 КонецЕсли;
		 
		 Если Отказ Тогда
		 
		 	Продолжить;
		 
		КонецЕсли;
		
		Движение = Движения.ОстаткиТовара.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = Выборка.Товар;
		Движение.Партия = Выборка.Партия;
		Движение.СрокГодности = Выборка.СрокГодности;
		Движение.Количество = Выборка.Количество;
		
	КонецЦикла;
	
КонецПроцедуры
