//нужно сделать партию как выбор из сроков годности
//если я правильно поняла, то нужно в событиях как-то фильтровать партии по срокам годности
//а в самом модуле объекта нужно уже реализовывать продажу.


//при продаже товара в табличной части необходимо предоставить возможность пользователю 
//выбирать конкретную партию списания (срок годности),
//при выборе партии следует ограничить выбор списком партий, которые уже имеются в наличии.

&НаКлиенте
Процедура СписокТоваровСрокГодностиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
	
	СписокСроковГодности = ПолучитьДаты(ТекущиеДанные.Товар);
	
	Если СписокСроковГодности.Количество() = 0 Тогда
	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Товара нет на складе пупупу";
		Сообщение.Сообщить();
		
		Возврат;
	
	КонецЕсли;
	
	ПараметрыВызова = Новый Структура; //чтобы не возникало ошибки с модальными окнами
	ПараметрыВызова.Вставить("ТекущиеДанные", ТекущиеДанные);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСрокаГодности", ЭтотОбъект, ПараметрыВызова);
	
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокСроковГодности, Элемент);	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСрокаГодности(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = ДополнительныеПараметры.ТекущиеДанные;
	СтрокаТаблицы.СрокГодности = ВыбранныйЭлемент.Значение;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьДаты(Товар)
	
	СписокДат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТовараОстатки.СрокГодности КАК СрокГодности
		|ИЗ
		|	РегистрНакопления.ОстаткиТовара.Остатки(, Товар = &Товар) КАК ОстаткиТовараОстатки";
	
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокДат.Добавить(Выборка.СрокГодности);
	КонецЦикла;
	
	Возврат СписокДат;

	
КонецФункции // ПолучитьДаты()
