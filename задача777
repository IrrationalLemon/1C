&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	Товары = ПолучитьТоварыИзЗаказа(Объект.Заказ);
	//Элементы.СписокТоваров.ТекущиеДанные.СтоимостьТовара = ПодстановкаЦенТоваров(Элементы.СписокТоваров.ТекущиеДанные.Товар);
	
	Если Товары.Количество() = 0 ИЛИ Товары = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список товаров вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Объект.СписокТоваров.Очистить();
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Объект.СписокТоваров.Добавить();
		НоваяСтрока.Товар = Стр.Товар;
		НоваяСтрока.Количество = Стр.Количество;
		НоваяСтрока.ЦенаПоставщика = ПодстановкаЦенПоставщика(Стр.Товар, Объект.Поставщик); 
		НоваяСтрока.СтоимостьТовара = ПодстановкаЦенТоваров(Стр.Товар);
		НоваяСтрока.Сумма = НоваяСтрока.ЦенаПоставщика * Стр.Количество;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварыИзЗаказа(Заказ)
	
	ТоварыМассив = Новый Массив;  // через список не получилось :(
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаСписокТоваров.Товар КАК Товар,
		|	ЗаказКлиентаСписокТоваров.Количество КАК Количество
		|ИЗ
		|	Документ.ЗаказКлиента.СписокТоваров КАК ЗаказКлиентаСписокТоваров
		|ГДЕ
		|	ЗаказКлиентаСписокТоваров.Ссылка = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТоварыМассив.Добавить(Новый Структура("Товар, Количество", Выборка.Товар, Выборка.Количество));
		
	КонецЦикла;
	
	Возврат ТоварыМассив;
КонецФункции


&НаСервере
Функция ПодстановкаЦенПоставщика(Товар, Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныПоставщиковСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныПоставщиков.СрезПоследних(
		|			&Дата,
		|			Товар = &Товар
		|				И Поставщик = &Поставщик) КАК ЦеныПоставщиковСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	
	РезультатЗапроса = Запрос.Выполнить();             //возвращает неопределенно, но при этом цены подставляются
	
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.Цена;
		КонецЦикла;

	КонецЕсли;
			
КонецФункции


&НаСервере
Функция ПодстановкаЦенТоваров(Товар)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныСрезПоследних.Стоимость КАК Стоимость
		|ИЗ
		|	РегистрСведений.Цены.СрезПоследних(&Дата, Товар = &Товар) КАК ЦеныСрезПоследних";
		
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.Стоимость;
		КонецЦикла;

	КонецЕсли;	
КонецФункции

