&НаКлиенте
Процедура КомандаФормирования(Команда)
	
	Заказы = ВывестиЗаказыКлиентов();
	
	Для Каждого стр Из Заказы Цикл
		
		НоваяСтрока = Объект.СписокЗаказов.Добавить();
		НоваяСтрока.Клиент = стр.Клиент;
		НоваяСтрока.Заказ = стр.Заказ;
		НоваяСтрока.Товар = стр.Товар;
		НоваяСтрока.ЦенаПоставщика = ЦенаПоставщикаПодставить(стр.Товар, Объект.Поставщик);
		НоваяСтрока.Количество = стр.Количество;
		
	КонецЦикла
	
КонецПроцедуры

&НаСервере
Функция ВывестиЗаказыКлиентов()

	МассивЗаказов = Новый Массив;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиЗаказовОстатки.Клиент КАК Клиент,
		|	ОстаткиЗаказовОстатки.ЗаказКлиента КАК Заказ,
		|	ОстаткиЗаказовОстатки.Товар КАК Товар,
		|	ОстаткиЗаказовОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиЗаказов.Остатки(, ) КАК ОстаткиЗаказовОстатки";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МассивЗаказов.Добавить(Новый Структура("Клиент, Заказ, Товар, Количество", Выборка.Клиент, Выборка.Заказ, Выборка.Товар, Выборка.Количество));
		
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

&НаСервере
Функция ЦенаПоставщикаПодставить(Товар, Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныПоставщикаСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныПоставщика.СрезПоследних(
		|			&Дата,
		|			Товар = &Товар
		|				И Поставщик = &Поставщик) КАК ЦеныПоставщикаСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе	
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Возврат Выборка.Цена;
			
		КонецЦикла;
		
	КонецЕсли;

КонецФункции
