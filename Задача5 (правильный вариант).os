Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.Записать();
	Движения.ОстаткиТовара.Записывать = Истина;
	Движения.ПродажиТовара.Записывать = Истина;
	
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродажаТоваровСписокТоваров.Товар КАК Товар,
		|	СУММА(ПродажаТоваровСписокТоваров.Количество) КАК Количество,
		|	СУММА(ПродажаТоваровСписокТоваров.Сумма) КАК Сумма
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Документ.ПродажаТоваров.СписокТоваров КАК ПродажаТоваровСписокТоваров
		|ГДЕ
		|	ПродажаТоваровСписокТоваров.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажаТоваровСписокТоваров.Товар
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Товар КАК Товар,
		|	вт.Количество КАК Количество,
		|	ОстаткиТовараОстатки.СрокГодности КАК СрокГодности,
		|	ЕСТЬNULL(ОстаткиТовараОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	вт.Товар.Представление КАК ТоварПредставление,
		|	вт.Сумма КАК Сумма
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
		|				&МоментВремени,
		|				Товар В
		|					(ВЫБРАТЬ
		|						вт.Товар
		|					ИЗ
		|						вт КАК вт)) КАК ОстаткиТовараОстатки
		|		ПО вт.Товар = ОстаткиТовараОстатки.Товар
		|
		|УПОРЯДОЧИТЬ ПО
		|	СрокГодности
		|ИТОГИ
		|	МАКСИМУМ(Количество),
		|	СУММА(КоличествоОстаток),
		|	СУММА(Сумма)
		|ПО
		|	Товар";
	
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТовар = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТовар.Следующий() Цикл
		
		Если ВыборкаТовар.Количество > ВыборкаТовар.КоличествоОстаток Тогда
		
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает товара: " + ВыборкаТовар.ТоварПредставление + " в количестве " + (-ВыборкаТовар.КоличествоОстаток);
			Сообщение.Сообщить();
		
		КонецЕсли;
		
		Если Отказ Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		КоличествоСписать = ВыборкаТовар.Количество;
	
		ВыборкаДетальныеЗаписи = ВыборкаТовар.Выбрать();
	                                                                                               
		Пока ВыборкаДетальныеЗаписи.Следующий() И КоличествоСписать > 0 Цикл
			
			Движение = Движения.ОстаткиТовара.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = ВыборкаДетальныеЗаписи.Товар;
			Движение.Количество = МИН(КоличествоСписать, ВыборкаДетальныеЗаписи.КоличествоОстаток);
			Движение.СрокГодности = ВыборкаДетальныеЗаписи.СрокГодности;
			
			КоличествоСписать = КоличествоСписать - Движение.Количество;
		КонецЦикла;
		
		Движение = Движения.ПродажиТовара.Добавить();
		Движение.Период = Дата;
		Движение.Товар = ВыборкаТовар.Товар;
		Движение.Количество = ВыборкаТовар.Количество;
		Движение.Сумма = ВыборкаТовар.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры
