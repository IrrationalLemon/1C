&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	Товары = ПолучитьТовары(Объект.Заказ);
	
	Если Товары.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список товаров вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;	
		
	КонецЕсли;
	
	Объект.СписокТоваров.Очистить();
	
	Для Каждого Стр Из Товары цикл
		
		НоваяСтрока = Объект.СписокТоваров.Добавить();
		НоваяСтрока.Товар = Стр.Товар;
		НоваяСтрока.ЦенаПоставщика = ЦенаПоставщика(Стр.Товар, Объект.Поставщик);
		НоваяСтрока.СтоимостьТовара = ЦенаДляПродажи(Стр.Товар);
		//НоваяСтрока.Количество = Стр.Количество;
		НоваяСтрока.Сумма = НоваяСтрока.ЦенаПоставщика * Стр.Количество; // разобраться с подсчетом
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьТовары(Заказ)

	ТоварыМассив = Новый Массив;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаСписокТоваров.Товар КАК Товар,
		|	ЗаказКлиентаСписокТоваров.Количество КАК Количество
		|ИЗ
		|	Документ.ЗаказКлиента.СписокТоваров КАК ЗаказКлиентаСписокТоваров
		|ГДЕ
		|	ЗаказКлиентаСписокТоваров.Ссылка = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТоварыМассив.Добавить(Новый Структура("Товар, Количество", Выборка.Товар, Выборка.Количество)); 
		
	КонецЦикла;
	
	Возврат ТоварыМассив;
	
КонецФункции

&НаСервере
Функция ЦенаПоставщика(Товар, Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныПоставщиковСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныПоставщиков.СрезПоследних(
		|			&Дата,
		|			Товар = &Товар
		|				И Поставщик = &Поставщик) КАК ЦеныПоставщиковСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			 Возврат Выборка.Цена;
			
		КонецЦикла;	
		
	КонецЕсли;	
КонецФункции

&НаСервере
Функция ЦенаДляПродажи(Товар)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныТоварСрезПоследних.Стоимость КАК Стоимость
		|ИЗ
		|	РегистрСведений.ЦеныТовар.СрезПоследних(&Дата, Товар = &Товар) КАК ЦеныТоварСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат 0;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			 Возврат Выборка.Стоимость;
			
		КонецЦикла;	
		
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура КонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаОбработка = Ложь;
	
	СписокКонтактов = ПолучитьКонтакты(Объект.Поставщик);
	
	Если СписокКонтактов.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Список клиентов вернул 0 или неопределено";
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыборкаКонтакт", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, СписокКонтактов, Элемент);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВыборкаКонтакт(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.КонтактноеЛицо = ВыбранныйЭлемент.Значение;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьКонтакты(Клиент)
	
	СписокКонтактов = Новый СписокЗначений;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрагентыСписокКонтактов.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	Справочник.Контрагенты.СписокКонтактов КАК КонтрагентыСписокКонтактов
		|ГДЕ
		|	КонтрагентыСписокКонтактов.Ссылка = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокКонтактов.Добавить(Выборка.КонтактноеЛицо);
	КонецЦикла;
	
    Возврат СписокКонтактов;
	
КонецФункции




