// задача 7


Процедура ОбработкаПроведения(Отказ, Режим)
	
	//Движения.ЗаказаноТовара.Очистить();
	Движения.Записать();
	Движения.ЗаказаноТовара.Записывать = Истина;
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщикуСписокТоваров.Товар КАК Товар,
		|	СУММА(ЗаказПоставщикуСписокТоваров.Количество) КАК Количество,
		|	СУММА(ЗаказПоставщикуСписокТоваров.Сумма) КАК Сумма
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Документ.ЗаказПоставщику.СписокТоваров КАК ЗаказПоставщикуСписокТоваров
		|ГДЕ
		|	ЗаказПоставщикуСписокТоваров.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПоставщикуСписокТоваров.Товар
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.Товар КАК Товар,
		|	вт.Количество КАК Количество,
		|	вт.Сумма КАК Сумма,
		|	ЗаказаноТовараОстатки.ЗаказКлиента КАК ЗаказКлиента,
		|	ЕСТЬNULL(ЗаказаноТовараОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	вт.Товар.Представление КАК ТоварПредставление
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказаноТовара.Остатки(
		|				&МоментВремени,
		|				Товар В
		|					(ВЫБРАТЬ
		|						вт.Товар
		|					ИЗ
		|						вт КАК вт)) КАК ЗаказаноТовараОстатки
		|		ПО вт.Товар = ЗаказаноТовараОстатки.Товар
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиента
		|ИТОГИ
		|	МАКСИМУМ(Количество),
		|	СУММА(Сумма),
		|	СУММА(КоличествоОстаток)
		|ПО
		|	Товар";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТовар = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТовар.Следующий() Цикл
		
		Если ВыборкаТовар.Количество > ВыборкаТовар.КоличествоОстаток Тогда
			
		    Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает товара: " + ВыборкаТовар.ТоварПредставление + " в количестве " + (-ВыборкаТовар.КоличествоОстаток);
			Сообщение.Сообщить();
		
		КонецЕсли;
		
		Если Отказ Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		КоличествоСписать = ВыборкаТовар.Количество;
		
		Выборка = ВыборкаТовар.Выбрать();
	
		Пока Выборка.Следующий()И КоличествоСписать > 0 Цикл
			
			Движение = Движения.ЗаказаноТовара.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Клиент = Клиент;
			Движение.ЗаказКлиента = Выборка.ЗаказКлиента;
			Движение.Товар = Выборка.Товар;
			Движение.Количество = МИН(КоличествоСписать, Выборка.КоличествоОстаток);
			
			КоличествоСписать = КоличествоСписать - Движение.Количество;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
